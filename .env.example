# Copy to .env.local and fill in. .env.local is gitignored.

# Solana mainnet RPC.
# The public endpoint (https://api.mainnet-beta.solana.com) is the fallback in
# lib/constants.ts, but it is rate-limited hard enough to fail under demo load.
# Use a dedicated endpoint — Helius, QuickNode, Triton — for anything real.
NEXT_PUBLIC_RPC_URL=

# Jupiter Swap API V2 base.
# Flow is GET /order -> sign -> POST /execute. This is NOT the Ultra API and
# NOT the legacy /swap/v1 quote+swap pair; Jupiter marks Ultra as superseded.
NEXT_PUBLIC_JUPITER_API=https://api.jup.ag/swap/v2

# Jupiter API key, sent as x-api-key. Optional: keyless requests work today
# but hit an undocumented rate limit quickly. Deliberately NOT prefixed
# NEXT_PUBLIC_: that prefix inlines the value into the client bundle, which
# would publish the key. Read only in lib/server/.
JUPITER_API_KEY=

# Pyth API key, sent as Authorization: Bearer. Optional, and unused by
# anything on screen: the equity and tokenized-stock feeds are not included
# in the plan this project has, so Pyth answers 403 for all of them and every
# price comes from Jupiter instead. Set it only if you hold a key whose plan
# covers those feeds. Server-only, same reasoning as above.
PYTH_API_KEY=

# Secret for signing swap order tokens, so /api/swap/execute only lands
# orders /api/swap/order approved as eligible. REQUIRED in production (on
# Vercel, the order and execute calls can hit different instances). Local
# `next dev` generates one if unset. Generate with: openssl rand -hex 32
VESTAIL_ORDER_SECRET=
