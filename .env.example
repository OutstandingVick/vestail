# Copy to .env.local and fill in. .env.local is gitignored.

# Solana mainnet RPC.
# The public endpoint (https://api.mainnet-beta.solana.com) is the fallback in
# lib/constants.ts, but it is rate-limited hard enough to fail under demo load.
# Use a dedicated endpoint — Helius, QuickNode, Triton — for anything real.
NEXT_PUBLIC_RPC_URL=

# Jupiter Swap API V2 base.
# Flow is GET /order -> sign -> POST /execute. This is NOT the Ultra API and
# NOT the legacy /swap/v1 quote+swap pair; Jupiter marks Ultra as superseded.
NEXT_PUBLIC_JUPITER_API=https://api.jup.ag/swap/v2

# Jupiter API key, sent as x-api-key. Optional: keyless requests work today
# but hit an undocumented rate limit quickly. Deliberately NOT prefixed
# NEXT_PUBLIC_: that prefix inlines the value into the client bundle, which
# would publish the key. Read only in lib/server/.
JUPITER_API_KEY=

# Pyth API key, sent as Authorization: Bearer. Required for any price read
# since the Pyth Core upgrade on 26 August 2026 (feed discovery is still
# open). Get one from Pyth Terminal. Without it, listed-share reference
# prices are unavailable and token prices fall back to Jupiter.
# Server-only, same reasoning as above.
PYTH_API_KEY=
