{
  "name": "own",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "own",
      "workspaces": [
        "packages/*",
        "services/*"
      ]
    },
    "node_modules/@own/api": {
      "resolved": "services/api",
      "link": true
    },
    "node_modules/@own/core": {
      "resolved": "packages/own-core",
      "link": true
    },
    "packages/own-core": {
      "name": "@own/core",
      "version": "0.1.0",
      "license": "UNLICENSED"
    },
    "services/api": {
      "name": "@own/api",
      "version": "0.1.0",
      "license": "UNLICENSED"
    }
  }
}
