{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestail.example/schemas",
  "$defs": {
    "Asset": { "type": "object", "required": ["id", "index", "name"], "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "index": { "type": "integer", "minimum": 0 }, "name": { "type": "string" } } },
    "Category": { "type": "object", "required": ["id", "name", "assets"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "assets": { "type": "array", "items": { "type": "string" }, "minItems": 1 } } },
    "Entity": { "type": "object", "required": ["name", "kind", "asset"], "properties": { "name": { "type": "string" }, "kind": { "type": "string" }, "home": { "type": "string", "pattern": "^[A-Z]{2}$" }, "asset": { "type": "string" } } },
    "Status": { "type": "integer", "enum": [0, 1, 2] },
    "Country": { "type": "object", "required": ["code", "name", "flag", "rules"], "properties": { "code": { "type": "string", "pattern": "^[A-Z]{2}$" }, "name": { "type": "string" }, "flag": { "type": "string" }, "rules": { "type": "object", "required": ["citizen", "foreigner"], "properties": { "citizen": { "type": "array", "items": { "$ref": "#/$defs/Status" } }, "foreigner": { "type": "array", "items": { "$ref": "#/$defs/Status" } } } } } },
    "Venue": { "type": "object", "required": ["name", "url"], "properties": { "name": { "type": "string" }, "url": { "type": ["string", "null"], "format": "uri" } } },
    "VenueMap": { "type": "object", "required": ["default"], "properties": { "default": { "type": "array", "items": { "$ref": "#/$defs/Venue" } } }, "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/Venue" } } },
    "Activity": { "type": "object", "properties": { "stats": { "type": "object", "properties": { "volume_30d_usd": { "type": "number" }, "volume_30d_delta_pct": { "type": "number" }, "orders_routed": { "type": "integer" }, "orders_delta_pct": { "type": "number" }, "active_buyers_7d": { "type": "integer" } } }, "recent": { "type": "array", "items": { "type": "object", "required": ["flag", "asset", "venue", "ago"], "properties": { "flag": { "type": "string" }, "asset": { "type": "string" }, "venue": { "type": "string" }, "ago": { "type": "string" } } } } } }
  }
}
