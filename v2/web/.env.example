# Privy (dashboard.privy.io): app ID is public, the secret is not.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Comma-separated Privy user IDs allowed to open /admin and its APIs.
# Example: did:privy:your-owner-user-id
VESTAIL_ADMIN_USER_IDS=

# Server-only key that signs the authorization granted after an invite is redeemed.
VESTAIL_INVITE_SECRET=
# Local invitation storage. Production uses KV_REST_API_URL and KV_REST_API_TOKEN below.
VESTAIL_INVITES_DIR=.data/invites

# The v2 API (npm start -w @vestail/api) and the key it accepts for clicks.
VESTAIL_API_URL=http://localhost:8787/v1
VESTAIL_API_KEY=local-dev-key

# Signs swap orders so /api/swap/execute only lands orders this server built.
# Required in production; generated per process in development.
VESTAIL_ORDER_SECRET=

# Optional: Jupiter Swap API key (server-only).
JUPITER_API_KEY=

# Server-only: wallet balances. Keep the key out of NEXT_PUBLIC_ variables.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Where the app keeps watchlists and portfolio value snapshots (a JSON file per user).
VESTAIL_DATA_DIR=.data

# Early-access signups use Upstash/Vercel KV in production and a local JSONL file in development.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VESTAIL_EARLY_ACCESS_FILE=.data/early-access.jsonl
