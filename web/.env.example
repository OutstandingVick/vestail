# Privy (dashboard.privy.io): app ID is public, the secret is not.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Comma-separated Privy user IDs allowed to open /admin and its APIs.
# Example: did:privy:your-owner-user-id
VESTAIL_ADMIN_USER_IDS=

# Server-only key that signs the authorization granted after an invite is redeemed.
# Keep stable: signs invite authorization and encrypts retrievable admin codes.
# Rotating it makes previously encrypted invitation codes unreadable.
VESTAIL_INVITE_SECRET=
# Local invitation storage. Production uses KV_REST_API_URL and KV_REST_API_TOKEN below.
VESTAIL_INVITES_DIR=.data/invites

# The v2 API is not reached over HTTP. It runs inside this app, in process
# (lib/server/local-api.ts), so there is no API URL or key to configure here
# and no second service to deploy. `npm start -w @vestail/api` still serves it
# standalone for the marketing page and for anyone integrating against it.

# Signs swap orders so /api/swap/execute only lands orders this server built.
# Required in production; generated per process in development.
VESTAIL_ORDER_SECRET=

# Optional: Jupiter Swap API key (server-only).
JUPITER_API_KEY=

# Server-only: wallet balances. Keep the key out of NEXT_PUBLIC_ variables.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Where the app keeps watchlists and portfolio value snapshots in development
# (a JSON file per user). In production they go to KV instead, see below.
VESTAIL_DATA_DIR=.data

# Upstash/Vercel KV. Required in production: invitations, early-access signups,
# watchlists and portfolio history all use it, and all fall back to local files
# only when these are unset. A hosted deploy has no writable disk, so leaving
# these blank there loses every write.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VESTAIL_EARLY_ACCESS_FILE=.data/early-access.jsonl
VESTAIL_TESTER_APPLICATIONS_FILE=.data/tester-applications.jsonl
